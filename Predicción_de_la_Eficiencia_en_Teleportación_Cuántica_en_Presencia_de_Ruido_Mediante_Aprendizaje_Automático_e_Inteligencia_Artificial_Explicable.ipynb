        "            yanchor='bottom',\n",
        "            len=0.6,\n",
        "            thickness=20\n",
        "        )\n",
        "    )\n",
        ")\n",
        "\n",
        "fig = go.Figure(data=[traza_superficie, traza_leyenda_fantasma])\n",
