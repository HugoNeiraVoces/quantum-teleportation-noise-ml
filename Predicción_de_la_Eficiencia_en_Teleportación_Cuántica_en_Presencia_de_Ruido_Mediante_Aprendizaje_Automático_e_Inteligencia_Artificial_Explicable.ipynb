    {
      "cell_type": "markdown",
      "source": [
        "Al aplicar la inversa del estado desconocido ahora al qubit de Bob, este debería dar 0. Vamos a comprobarlo"
      ],
      "metadata": {
        "id": "3JDAHB8TcXll"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
        },
        "id": "_JcI4cP1YAZK",
        "outputId": "a43c62fc-3e9e-4e9a-9edf-658ec7eefb0f"
      },
      "outputs": [
        {
          "data": {
            "image/png": "\n",
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ]
          },
          "execution_count": 8,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "# Use the Aer simulator\n",
        "backend = AerSimulator()\n",
        "\n",
        "# Transpile to backend\n",
        "pm = generate_preset_pass_manager(backend=backend, optimization_level=1)\n",
        "isa_qc = pm.run(qc)\n",
        "\n",
        "# Run the job\n",
        "sampler = Sampler(mode=backend)\n",
        "job = sampler.run([isa_qc], shots=1000)\n",
        "result = job.result()\n",
        "\n",
        "# Extract counts data\n",
        "counts = result[0].data.c.get_counts()\n",
        "\n",
        "# Plot the counts in a histogram\n",
        "plot_histogram(counts)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
        },
        "id": "m0tV-qy4YA_P",
        "outputId": "f050b37d-1528-449c-8196-00a7c1c2a28b"
      },
      "outputs": [
        {
          "data": {
            "image/png": "\n",
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ]
          },
          "execution_count": 9,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "#Quedarnos sólo con los de Bob para verlo mejor\n",
        "bobs_qubit = 2\n",
        "bobs_counts = marginal_counts(counts, [bobs_qubit])\n",
        "plot_histogram(bobs_counts)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "PyfS1mPYYFdh"
      },
      "source": [
        "Como se puede ver esta teletransportación ha salido perfecta pero por desgracia en la realidad esto no es así, ya que en la realidad hay ruido, por suerte el ruido también se puede simular.\n",
        "\n",
        "Para ver que realmente el ruido afecta a la teleportación vamos a hacer una prueba."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Edsaxj_HYEvL"
      },
      "outputs": [],
      "source": [
        "# https://qiskit.github.io/qiskit-aer/stubs/qiskit_aer.noise.coherent_unitary_error.html#qiskit_aer.noise.coherent_unitary_error\n",
        "OVER_ROTATION_ANGLE = 0.05\n",
        "coherent_error = coherent_unitary_error(RXGate(OVER_ROTATION_ANGLE).to_matrix())\n",
        "\n",
        "# https://qiskit.github.io/qiskit-aer/stubs/qiskit_aer.noise.amplitude_damping_error.html#qiskit_aer.noise.amplitude_damping_error\n",
        "AMPLITUDE_DAMPING_PARAM = 0.02  # in [0, 1] (0: no error)\n",
        "incoherent_error = amplitude_damping_error(AMPLITUDE_DAMPING_PARAM)\n",
        "\n",
        "# https://qiskit.github.io/qiskit-aer/stubs/qiskit_aer.noise.ReadoutError.html#qiskit_aer.noise.ReadoutError\n",
        "PREP0_MEAS1 = 0.03\n",
        "PREP1_MEAS0 = 0.08\n",
        "readout_error = ReadoutError([\n",
        "    [1 - PREP0_MEAS1, PREP0_MEAS1],\n",
        "    [PREP1_MEAS0, 1 - PREP1_MEAS0]\n",
        "])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "VeGbVVfLYJVj"
      },
      "outputs": [],
      "source": [
        "noise_model = NoiseModel()\n",
        "noise_model.add_quantum_error(coherent_error.compose(incoherent_error), 'x', (0, ))\n",
        "noise_model.add_readout_error(readout_error, (0, ))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "7Dvi2yDhYJ-M"
      },
      "outputs": [],
      "source": [
        "from qiskit_aer.primitives import SamplerV2 as Sampler\n",
        "noisy_sampler = Sampler(options={\"backend_options\": {\"noise_model\": noise_model}})"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
