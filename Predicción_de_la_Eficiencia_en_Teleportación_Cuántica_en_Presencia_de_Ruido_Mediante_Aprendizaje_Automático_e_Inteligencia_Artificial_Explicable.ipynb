      "source": [
        "#NO VOLVER A CORRER ESTE CÓDIGO PORQUE LOS VALORES DEL RUIDO VAN CAMBIANDO, CON LO QUE LA PREDICCIÓN QUE HACEMOS BASÁNDONOS EN EL REAL YA NO SE PODRÍA COMPARAR CON ESTE Y HABRÍA QUE VOLVERLA A HACER\n",
        "import time\n",
        "from qiskit.transpiler import Layout\n",
        "\n",
        "service = QiskitRuntimeService(channel=\"ibm_quantum\", token=\"\")\n",
        "real_backend = service.backend(\"ibm_sherbrooke\")\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "theta = np.random.uniform(0.0, 1.0) * np.pi    #de 0 a pi\n",
        "varphi = np.random.uniform(0.0, 2.0) * np.pi    #de 0 a 2*pi\n",
        "\n",
        "#Crear el circuito de teletransportación cuántica\n",
        "qc = QuantumCircuit(3, 3)\n",
        "\n",
        "# Alice crea un estado cuántico desconocido\n",
        "qc.u(theta, varphi, 0.0, 0)\n",
        "\n",
        "qc.h(1)\n",
        "qc.cx(1, 2)\n",
        "\n",
        "qc.cx(0, 1)\n",
        "qc.h(0)\n",
        "\n",
        "#Alice mide los dos qubits\n",
        "qc.measure(0, 0)\n",
        "qc.measure(1, 1)\n",
        "\n",
        "#Alice envía los resultados a Bob. Ahora, Bob aplica correcciones\n",
        "with qc.if_test((0, 1)):\n",
        "    qc.z(2)\n",
        "with qc.if_test((1, 1)):\n",
        "    qc.x(2)\n",
        "\n",
        "#Aplicar la inversa para medir el estado |0>\n",
        "qc.u(theta, varphi, 0.0, 2).inverse()\n",
        "qc.measure(2, 2)\n",
        "\n",
        "layout = Layout.from_intlist([0, 1, 2], qc.qregs[0])  # Qubits físicos 0,1,2\n",
        "\n",
        "pm = generate_preset_pass_manager(\n",
        "    backend=real_backend,\n",
        "    optimization_level=0,\n",
        "    initial_layout=layout\n",
        ")\n",
        "qc_compiled = pm.run(qc)\n",
        "\n",
        "sampler = Sampler(real_backend)\n",
        "\n",
        "job = sampler.run([qc_compiled])\n",
        "\n",
        "#Configurar el servicio de IBM y el backend\n",
        "job_real = service.job(job.job_id())  #Asegúrate de usar tu propio job_id\n",
        "\n",
        "#Esperar hasta que el trabajo esté en estado 'DONE'\n",
        "while job_real.status() != 'DONE':\n",
        "    print(\"El trabajo aún no ha terminado, estado actual:\", job_real.status())\n",
        "    time.sleep(0.000001)\n",
        "\n",
        "#Una vez que el trabajo esté en estado 'DONE', obtenemos los resultados\n",
        "print(\"El trabajo ha terminado. Resultados disponibles.\")\n",
        "result_real = job_real.result()\n",
        "\n",
        "#Obtener los counts de las mediciones de Bob (qubit 2)\n",
        "result_real = job_real.result()\n",
        "real_counts = result_real[0].data.c.get_counts()\n",
        "bobs_counts = marginal_counts(real_counts, [2])\n",
        "\n",
        "#Mostrar la fidelidad de la teletransportación\n",
        "num_shots = 50\n",
        "fidelity_total = 0.0\n",
        "num_iterations = 5\n",
        "\n",
        "for _ in range(num_iterations):\n",
        "    job = sampler.run([qc_compiled], shots=num_shots)\n",
        "    result = job.result()\n",
        "    real_counts = result_real[0].data.c.get_counts()\n",
        "    bobs_counts = marginal_counts(real_counts, [2])\n",
        "    total_counts = sum(bobs_counts.values())\n",
        "    fidelity_total += bobs_counts.get('0', 0) / total_counts\n",
        "\n",
        "avg_fidelity = fidelity_total / num_iterations\n",
        "print(f\"Fidelidad promedio: {avg_fidelity:.4f}\")\n",
        "\n",
        "qc_compiled.draw(\"mpl\", idle_wires=False)"
      ],
