      "source": [
        "#Entrelazamiento de Alice y Bob\n",
        "qc.h(1)\n",
        "qc.cx(1, 2)\n",
        "qc.barrier()\n",
        "\n",
        "\n",
        "#Alice se entrelaza con el estado desconocido\n",
        "qc.cx(0, 1)\n",
        "qc.h(0)\n",
        "qc.barrier()\n",
        "\n",
        "#Alice mide el estado desconocido y su propio qubit\n",
        "qc.measure(0, 0)\n",
        "qc.measure(1, 1)\n",
        "\n",
        "#Los resultados obtenidos por Alice se envían a Bob de manera clásica y este aplica correcciones\n",
        "with qc.if_test((0, 1)):\n",
        "    qc.z(2)\n",
        "with qc.if_test((1, 1)):\n",
        "    qc.x(2)\n",
        "qc.barrier()\n",
        "\n",
        "backend = StatevectorSimulator()\n",
        "out_vector = backend.run(qc, shots=1).result().get_statevector()\n",
        "\n",
        "fig = plot_bloch_multivector(out_vector)\n",
        "\n",
        "axes = fig.axes\n",
        "axes[0].set_title('Estado Desconocido', y=1.1)\n",
        "axes[1].set_title('Alice',y=1.1)\n",
        "axes[2].set_title('Bob',y=1.1)  # Este es el qubit que tiene el estado original de Alice\n",
        "\n",
        "fig"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Aplicamos la función inversa del estado desconocido para comprobar que la teletransportación salió bien\n",
        "qc.u(theta, varphi, 0.0, 2).inverse()    #Inversa\n",
        "qc.measure(2, 2)\n",
        "\n",
        "qc.draw(output=\"mpl\")"
      ],
