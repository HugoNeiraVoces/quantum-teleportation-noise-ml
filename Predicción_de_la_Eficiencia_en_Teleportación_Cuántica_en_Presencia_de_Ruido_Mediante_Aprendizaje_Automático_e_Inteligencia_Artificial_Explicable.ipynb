        }
      ],
      "source": [
        "#Teletransportación cuántica con este error\n",
        "job = noisy_sampler.run([isa_qc], shots=1000)\n",
        "result = job.result()\n",
        "counts = result[0].data.c.get_counts()\n",
        "bobs_counts = marginal_counts(counts, [bobs_qubit])\n",
        "plot_histogram(bobs_counts)"
      ]
