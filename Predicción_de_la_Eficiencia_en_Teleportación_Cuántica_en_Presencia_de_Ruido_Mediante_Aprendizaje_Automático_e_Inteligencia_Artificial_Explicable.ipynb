        "def etiqueta_fidelidad(f):\n",
        "    if f >= 0.90:\n",
        "        return 0\n",
        "    elif f >=0.75:\n",
        "        return 1\n",
        "    elif f >=0.50:\n",
        "        return 2\n",
        "    elif f >=0.25:\n",
        "        return 3\n",
        "    else:\n",
        "        return 4"
